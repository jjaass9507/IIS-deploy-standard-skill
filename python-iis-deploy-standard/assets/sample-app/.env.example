# Copy to shared\config\.env on the server (APP_CONFIG_FILE points at it).
# production: refuses to start unless AUTH_MODE=ad and SECRET_KEY is set.
APP_ENV=development
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# off / mock / ad. Production must be ad.
AUTH_MODE=mock
AUTH_SSO_ENABLED=false
# true when the site is served over HTTPS (production).
SESSION_COOKIE_SECURE=false

# ldap://<NetBIOS or DC host>, or ldaps://<AD host FQDN>:636
AD_SERVER=ldaps://<AD host FQDN>:636
AD_DOMAIN=<NetBIOS domain>
# Optional: CA certificate file. When set together with ldaps://, the server certificate is verified.
AD_CA_FILE=

# Accounts allowed to use the platform: account=role, comma separated.
PLATFORM_USERS=
